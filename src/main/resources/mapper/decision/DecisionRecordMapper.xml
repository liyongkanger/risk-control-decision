<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dmp.riskdecision.decision.mapper.DecisionRecordMapper">
    <resultMap id="recordMap" type="com.dmp.riskdecision.decision.mapper.DecisionRecordRow">
        <id property="id" column="id"/>
        <result property="executionId" column="execution_id"/>
        <result property="requestId" column="request_id"/>
        <result property="sceneCode" column="scene_code"/>
        <result property="versionId" column="version_id"/>
        <result property="status" column="status"/>
        <result property="conclusion" column="conclusion"/>
        <result property="errorCode" column="error_code"/>
        <result property="inputJson" column="input_json"/>
        <result property="resultJson" column="result_json"/>
        <result property="inserttime" column="inserttime"/>
        <result property="updatetime" column="updatetime"/>
        <result property="isactive" column="isactive"/>
    </resultMap>
    <sql id="columns">id, execution_id, request_id, scene_code, version_id, status,
        conclusion, error_code, input_json, result_json, inserttime, updatetime, isactive</sql>
    <sql id="summaryColumns">id, execution_id, request_id, scene_code, version_id, status,
        conclusion, error_code, inserttime, updatetime, isactive</sql>
    <sql id="filters">
        isactive = 1
        <if test="sceneCode != null">AND scene_code = #{sceneCode}</if>
        <if test="requestId != null">AND request_id = #{requestId}</if>
        <if test="status != null">AND status = #{status}</if>
    </sql>
    <select id="findByExecutionId" resultMap="recordMap">
        SELECT <include refid="columns"/> FROM tb_decision_execution_record
        WHERE execution_id = #{executionId} AND isactive = 1
    </select>
    <select id="search" resultMap="recordMap">
        SELECT <include refid="summaryColumns"/> FROM tb_decision_execution_record
        WHERE <include refid="filters"/>
        ORDER BY id DESC LIMIT #{pageSize} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM tb_decision_execution_record WHERE <include refid="filters"/>
    </select>
</mapper>
